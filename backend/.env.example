# Copy to backend/.env and fill in.

# --- Gemini ------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.2

# --- Latency / quota ---------------------------------------------------------
# Cache identical requests. On the free tier the binding limit is requests per
# day, so this is what makes re-running an analysis or a demo possible at all.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_DAYS=30
# Concurrent agent calls. Raise it if you have billing enabled; the free tier
# also caps requests per minute, and a wide fan-out trips that immediately.
LLM_MAX_CONCURRENCY=3
# Requests per minute. A concurrency cap bounds calls in flight but not the
# rate they are issued: the free tier allows five a minute, at which a
# five-paper fan-out fails outright even with only three in flight.
# Set to 0 to disable throttling once billing is enabled.
LLM_REQUESTS_PER_MINUTE=5
# Per-request deadline, and a ceiling on one call's whole retry loop.
LLM_TIMEOUT_SECONDS=90
LLM_TOTAL_RETRY_SECONDS=180

# --- OCR (scanned PDFs) ------------------------------------------------------
# Applied per page: a paper that is born-digital except for a photocopied
# appendix only has that appendix recognised.
OCR_ENABLED=true
# auto | rapidocr | gemini | none.  "gemini" costs one API request per page.
OCR_ENGINE=auto
OCR_DPI=200
# A page with fewer characters than this is a candidate for OCR...
OCR_MIN_CHARS_PER_PAGE=120
# ...but only if images cover this much of it; otherwise it is simply blank.
OCR_MIN_IMAGE_COVERAGE=0.25
OCR_MAX_PAGES_PER_DOCUMENT=40
OCR_MIN_CONFIDENCE=0.5
# How far the detector expands each text polygon. The engine default (1.6) is
# tuned for signage and silently drops closely-spaced lines of body text.
OCR_UNCLIP_RATIO=2.0
OCR_CACHE_ENABLED=true

# --- Figures, charts and tables ----------------------------------------------
# Extraction runs during ingestion and costs nothing. *Reading* a figure is one
# vision request each, so it is always an explicit action in the UI.
FIGURES_ENABLED=true
FIGURE_DPI=150
FIGURE_MAX_PER_DOCUMENT=60
FIGURE_MAX_ANALYSIS_BATCH=40

# --- Discovery (OpenAlex) ----------------------------------------------------
# No API key needed. A contact address is optional but puts requests in
# OpenAlex's faster pool.
DISCOVERY_ENABLED=true
OPENALEX_CONTACT_EMAIL=

# --- Conversations -----------------------------------------------------------
# Previous turns replayed into a follow-up question. Each one costs prompt
# tokens, so the window is bounded.
CONVERSATION_MEMORY_TURNS=6

# --- Neo4j -------------------------------------------------------------------
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchcompass

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# "auto" prefers the faster ONNX path (fastembed) and falls back to PyTorch.
# Force one with "fastembed" or "sentence-transformers".
EMBEDDING_BACKEND=auto
# Set to true on machines that cannot download the model (uses a deterministic
# hashing embedder so the pipeline still works, with lower retrieval quality).
EMBEDDING_OFFLINE_FALLBACK=false

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=8

# --- Authentication ----------------------------------------------------------
# Signs access and activation tokens. Leave empty and one is generated per
# process, which ends every session on restart — set it for anything real.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=720
ACTIVATION_TOKEN_MINUTES=5
PASSWORD_MIN_LENGTH=6
# Where activation links point: the frontend, not the API.
APP_BASE_URL=http://localhost:8080

# --- Email -------------------------------------------------------------------
# Unset: the activation link is logged, and outside production it is returned by
# the register endpoint so sign-up still works on a laptop.
# For Gmail use an App Password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ResearchCompass <no-reply@researchcompass.local>
SMTP_USE_TLS=true
