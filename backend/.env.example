# Copy to backend/.env and fill in.

# --- Gemini ------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.2

# --- Neo4j -------------------------------------------------------------------
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchcompass

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set to true on machines that cannot download the model (uses a deterministic
# hashing embedder so the pipeline still works, with lower retrieval quality).
EMBEDDING_OFFLINE_FALLBACK=false

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=8
