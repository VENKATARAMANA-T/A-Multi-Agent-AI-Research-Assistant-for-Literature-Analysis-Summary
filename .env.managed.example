# ResearchCompass — settings for a MANAGED deployment (no server of your own).
#
# For the single-server Oracle/VM deployment use .env.prod.example instead.
# Copy these into your platform's secrets UI. Do not commit a filled-in copy.
#
# Every variable below is read by backend/app/config.py. The ones marked
# REQUIRED have no usable default in a deployment.

# --- LLM ---------------------------------------------------------------------
GOOGLE_API_KEY=                      # REQUIRED. Free tier is 20 requests/day,
                                     # shared by everyone using the deployment.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# The fallback matters more than it looks: each model has its own daily quota,
# so a second entry roughly doubles the free-tier headroom.

# --- Database (Neon, Supabase, any managed Postgres) -------------------------
DATABASE_URL=                        # REQUIRED. postgresql+psycopg://user:pass@host/db?sslmode=require
                                     # Without it the app falls back to SQLite on
                                     # a disk that does not survive a restart.

# --- Vector store (Chroma Cloud or a Chroma server) --------------------------
CHROMA_MODE=http                     # REQUIRED for hosts without durable disk
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=true
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# --- Object storage (Cloudflare R2, Backblaze B2, MinIO, S3) -----------------
STORAGE_BACKEND=s3                   # REQUIRED for hosts without durable disk
S3_BUCKET=
S3_ENDPOINT_URL=                     # R2: https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# --- Knowledge graph (Neo4j Aura) --------------------------------------------
NEO4J_ENABLED=true
NEO4J_URI=                           # neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=                      # Aura shows this once, at creation.
NEO4J_DATABASE=neo4j
# Aura Free pauses an instance after 3 days of inactivity and deletes one left
# paused for 30. Any regular traffic prevents both; /api/health touches the
# graph, so a twice-daily ping is enough on its own.

# --- Embeddings ---------------------------------------------------------------
EMBEDDING_BACKEND=fastembed          # REQUIRED with requirements-prod.txt.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Left on "auto" without torch installed, the app silently falls back to the
# hashing embedder and retrieval quality collapses with no error.

# --- Accounts and email -------------------------------------------------------
JWT_SECRET=                          # REQUIRED. 32+ random characters.
                                     # Left empty, a new one is generated per
                                     # process and every restart signs everyone out.
APP_BASE_URL=                        # REQUIRED. The public frontend URL —
                                     # activation links are built from it.
SMTP_HOST=                           # REQUIRED, or accounts cannot be activated
SMTP_PORT=587                        # and nobody can sign in.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ResearchCompass <no-reply@example.com>

# --- Frontend origin ----------------------------------------------------------
CORS_ORIGINS=                        # REQUIRED. https://your-app.vercel.app
                                     # The frontend is no longer same-origin:
                                     # nginx proxied /api only in the compose setup.

# --- Resource tuning ----------------------------------------------------------
MALLOC_ARENA_MAX=2
LLM_MAX_CONCURRENCY=2                # Each parallel branch holds its own prompt.
LLM_REQUESTS_PER_MINUTE=5
# OCR is off in the production image: RapidOCR needs 150-250 MB beside the
# embedder, which a 512 MB instance does not have. Set OCR_ENABLED=true and
# raise these wherever the host has more room.
OCR_ENABLED=false
OCR_DPI=150                          # 200 is the accuracy optimum; 150 halves
OCR_MAX_PAGES_PER_DOCUMENT=10        # the peak memory of a page render.
FIGURE_MAX_ANALYSIS_BATCH=10
LOG_LEVEL=INFO
ENVIRONMENT=production
